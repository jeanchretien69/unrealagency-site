{
  "manifest_version": 3,
  "name": "Unreal Work",
  "version": "1.0.0",
  "description": "Work tracker for the Unreal Agency team: time on each site, activity and task timer. Only tracks the Chrome profile it is installed in.",
  "icons": { "16": "icons/i16.png", "32": "icons/i32.png", "48": "icons/i48.png", "128": "icons/i128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Unreal Work", "default_icon": { "16": "icons/i16.png", "32": "icons/i32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["https://ljhpdqttcxwgufcejfor.supabase.co/*"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }]
}
